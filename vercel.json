{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "github": {
    "silent": true
  },
  "routes": [
    {
      "src": "/(netflix|نتفلكس)",
      "status": 301,
      "destination": "/"
    }
  ]
}